## 5 — Item
type_ids = lastids('Type', 'type_id')
not_yet_ordered_id = cur.execute(
    "SELECT acquisition_status_id FROM Acquisition_Status WHERE status_name='Not Yet Ordered'"
).fetchone()[0]

# Real, recognizable titles instead of fake.catch_phrase(). Every item starts
# at 'Not Yet Ordered' here -- corrected to 'Acquired' once Item_Copy is
# populated below (cell 7 of this section), based on which items actually
# end up with a real copy, mirroring the real procurement pipeline instead
# of assigning a status at random.
ITEMS = [
    ("Sapiens: A Brief History of Humankind", 2011, "Nonfiction"),
    ("Steve Jobs", 2011, "Biography"),
    ("Good Omens", 1990, "Fantasy"),
    ("The Autobiography of Malcolm X", 1965, "Biography"),
    ("Project Hail Mary", 2021, "Science Fiction"),
    ("Freakonomics", 2005, "Nonfiction"),
    ("Dune", 1965, "Science Fiction"),
    ("The Girl with the Dragon Tattoo", 2005, "Mystery"),
    ("Cosmos", 1980, "Science"),
    ("Harry Potter and the Philosopher's Stone", 1997, "Fantasy"),
    ("Atomic Habits", 2018, "Self-Help"),
    ("The Da Vinci Code", 2003, "Mystery"),
    ("Charlotte's Web", 1952, "Children"),
    ("A Brief History of Time", 1988, "Science"),
    ("National Geographic", 2024, "Nature"),
]
magazine_type = cur.execute("SELECT type_id FROM Type WHERE type_name='Magazine'").fetchone()
book_type_id = random.choice(type_ids)

item_rows = []
for i, (title, year, genre) in enumerate(ITEMS):
    is_magazine = (i == len(ITEMS) - 1) and magazine_type
    type_id = magazine_type[0] if is_magazine else book_type_id
    item_rows.append((title, year, genre, LIBRARY_ID, type_id, not_yet_ordered_id))

cur.executemany(
    'INSERT INTO Item (title,publication_year,genre,library_id,type_id,acquisition_status_id) VALUES (?,?,?,?,?,?)',
    item_rows
)
con.commit()
item_ids = lastids('Item', 'item_id')
print(f'Item: {len(item_ids)} rows inserted')

## 6 — Written_By  (Item ↔ Author, M:N)
# Real authorship, including genuine multi-author books, instead of random
# item/author pairing. One Item row per title regardless of author count --
# multi-author books just get more Written_By rows, never a duplicate Item row.
id_by_title = dict(zip([t for t, _, _ in ITEMS], item_ids))
id_by_name  = dict(zip(AUTHOR_NAMES, author_ids))

def aid(first, last):
    return id_by_name[(first, last)]

written_by_map = {
    "Sapiens: A Brief History of Humankind":       [("Yuval Noah", "Harari")],
    "Steve Jobs":                                   [("Walter", "Isaacson")],
    "Good Omens":                                   [("Neil", "Gaiman"), ("Terry", "Pratchett")],
    "The Autobiography of Malcolm X":                [("Malcolm", "X"), ("Alex", "Haley")],
    "Project Hail Mary":                            [("Andy", "Weir")],
    "Freakonomics":                                 [("Steven", "Levitt"), ("Stephen", "Dubner")],
    "Dune":                                         [("Frank", "Herbert")],
    "The Girl with the Dragon Tattoo":               [("Stieg", "Larsson")],
    "Cosmos":                                       [("Carl", "Sagan")],
    "Harry Potter and the Philosopher's Stone":      [("J.K.", "Rowling")],
    "Atomic Habits":                                [("James", "Clear")],
    "The Da Vinci Code":                            [("Dan", "Brown")],
    "Charlotte's Web":                              [("E.B.", "White")],
    "A Brief History of Time":                      [("Stephen", "Hawking")],
    "National Geographic":                          [],  # magazine -- no author
}

written_by_rows = []
for title, authors in written_by_map.items():
    for first, last in authors:
        written_by_rows.append((id_by_title[title], aid(first, last)))

cur.executemany('INSERT OR IGNORE INTO Written_By (item_id, author_id) VALUES (?,?)', written_by_rows)
con.commit()
print(f'Written_By: {len(written_by_rows)} rows inserted')

## 7 — Item_Copy
copy_status_ids = lastids('Copy_Status', 'copy_status_id')
# Get the 'Available' status id — needed so trigger T3 allows loans later
available_status_id = cur.execute(
    "SELECT copy_status_id FROM Copy_Status WHERE status_name='Available'"
).fetchone()[0]

copy_rows = []
for _ in range(20):   # more copies than items — realistic
    copy_rows.append((
        rdate('2010-01-01', '2024-01-01'),
        random.choice(item_ids),
        available_status_id     # start all copies as Available; triggers will update
    ))

cur.executemany(
    'INSERT INTO Item_Copy (date_obtained, item_id, copy_status_id) VALUES (?,?,?)',
    copy_rows
)
con.commit()
copy_ids = lastids('Item_Copy', 'item_copy_id')
print(f'Item_Copy: {len(copy_ids)} rows inserted')
# Now that copies exist, correct each item's acquisition_status: items with
# >=1 real copy are 'Acquired'; items with zero copies stay in the pre-copy
# pipeline (split across 'Not Yet Ordered' / 'Ordered').
acquired_id = cur.execute("SELECT acquisition_status_id FROM Acquisition_Status WHERE status_name='Acquired'").fetchone()[0]
ordered_id  = cur.execute("SELECT acquisition_status_id FROM Acquisition_Status WHERE status_name='Ordered'").fetchone()[0]

cur.execute('''
    UPDATE Item SET acquisition_status_id = ?
    WHERE item_id IN (SELECT DISTINCT item_id FROM Item_Copy)
''', (acquired_id,))

copyless = [r[0] for r in cur.execute('''
    SELECT item_id FROM Item
    WHERE item_id NOT IN (SELECT DISTINCT item_id FROM Item_Copy)
''').fetchall()]
for i, iid in enumerate(copyless):
    status = ordered_id if i % 2 == 0 else not_yet_ordered_id
    cur.execute('UPDATE Item SET acquisition_status_id = ? WHERE item_id = ?', (status, iid))
con.commit()
print(f'Acquisition_status corrected for {len(item_ids)} items ({len(item_ids)-len(copyless)} acquired, {len(copyless)} still pending)')

