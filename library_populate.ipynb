## 11 — Event
One event per (room, date) pair — satisfies trigger T6.
EVENT_OPTIONS = [
    ("Mystery Lovers Book Club", "Book Club"),
    ("Classics Book Club Meetup", "Book Club"),
    ("Meet the Author: Local Fiction Night", "Author Talk"),
    ("In Conversation with a Debut Novelist", "Author Talk"),
    ("Classic Film Night: Casablanca", "Movie Screening"),
    ("Documentary Screening: Our Planet", "Movie Screening"),
    ("Resume Writing Workshop", "Workshop"),
    ("Introduction to Watercolor Painting", "Workshop"),
    ("Toddler Story Time", "Story Time"),
    ("Bedtime Stories for Kids", "Story Time"),
    ("Tech Help Drop-In: Smartphones & Tablets", "Tech Help"),
    ("One-on-One Computer Help Session", "Tech Help"),
    ("Beginner Sketching Class", "Art Class"),
    ("Community Art Night", "Art Class"),
    ("English-Spanish Language Exchange", "Language Exchange"),
    ("Conversation Circle: Practice Your French", "Language Exchange"),
]

event_rows = []
used_room_dates = set()
attempts = 0
options = pick(EVENT_OPTIONS, min(12, len(EVENT_OPTIONS)))
while len(event_rows) < len(options) and attempts < 500:
    attempts += 1
    room_id = random.choice(room_ids)
    ev_date = rdate('2024-01-01', '2025-06-30')
    if (room_id, ev_date) in used_room_dates:
        continue
    used_room_dates.add((room_id, ev_date))
    title, event_type = options[len(event_rows)]
    event_rows.append((title, ev_date, event_type, room_id))

cur.executemany(
    'INSERT INTO Event (title, date, event_type, room_id) VALUES (?,?,?,?)',
    event_rows
)
con.commit()
event_ids = lastids('Event', 'event_id')
print(f'Event: {len(event_ids)} rows inserted')

